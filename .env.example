# Copy to .env and adjust. Every value is optional; the defaults are shown.
# Relative paths are resolved from the project root.

# --- General ---------------------------------------------------------------
LOG_LEVEL=INFO

# --- Storage (keep these out of Git: they can contain personal data) ---------
DATABASE_PATH=storage/document_ai.db
THUMBNAILS_DIR=storage/thumbnails
DEBUG_IMAGES_DIR=storage/debug
# Save aligned/preprocessed card images for debugging (contains personal data!)
SAVE_DEBUG_IMAGES=false

# --- Upload limits ------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10
MAX_IMAGE_PIXELS=40000000
MIN_IMAGE_SIDE_PX=100
ALLOWED_IMAGE_FORMATS=jpeg,png,webp,bmp,tiff

# --- OCR engine: "tesseract" (default) or "easyocr" ----------------------------
OCR_ENGINE=tesseract
# Full path to tesseract.exe if it is not on PATH, e.g.
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
TESSERACT_CMD=
# Folder containing eng.traineddata, only if Tesseract cannot find it itself
TESSERACT_DATA_DIR=
TESSERACT_LANG=eng
# Page segmentation mode 11 = "sparse text", which suits ID cards
TESSERACT_PSM=11
# EasyOCR (pip install -r requirements-easyocr.txt); models download on first use
EASYOCR_LANGUAGES=en
EASYOCR_MODEL_DIR=
EASYOCR_GPU=false
# Card image size (long side, pixels) used for OCR
OCR_TARGET_LONG_SIDE=1400
# Retry OCR at 90/180/270 degrees when the first reading is weak
OCR_TRY_ROTATIONS=true

# --- Field extraction -----------------------------------------------------------
# How to read ambiguous numeric dates like 04/05/1990: DMY or MDY (US cards)
DATE_ORDER=DMY

# --- API ------------------------------------------------------------------------
# Include raw and normalised OCR text in responses and stored records
INCLUDE_OCR_TEXT=true
# Comma-separated browser origins allowed to call the API (empty = CORS disabled)
CORS_ALLOW_ORIGINS=
